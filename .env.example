
DATABASE_URL=your_database_url_here

# Connection pool (all optional — app/database.py has the defaults and the
# reasoning). DB_POOL_SIZE + DB_MAX_OVERFLOW is the most this process will open
# at once; keep the sum under the database's max_connections, times the number
# of app instances.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

SECRET_KEY = your_secret_key_here
ALGORITHM = "HS256"
ACCESS_TOKEN_EXPIRE_MINUTES = 10080

# Email. Note: Render's free instances block outbound SMTP ports, so these
# sends fail there with "[Errno 101] Network is unreachable".
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME="your_smtp_username_here"
SMTP_PASSWORD="your_smtp_password_here"

# Public base URLs used to build links inside emails.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
GEMINI_API_KEY=your_gemini_api_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here
PARSEBOT_API_KEY=your_parsebot_api_key_here
SERP_API_KEY=your_serp_api_key_here