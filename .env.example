
DATABASE_URL=your_database_url_here
SECRET_KEY = your_secret_key_here
ALGORITHM = "HS256"
ACCESS_TOKEN_EXPIRE_MINUTES = 10080

# Email. Brevo's HTTP API is the production transport — Render blocks
# outbound SMTP ports, so smtplib fails there with "Network is unreachable".
# Leave BREVO_API_KEY unset locally to fall back to the SMTP settings below.
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_SENDER_NAME="PickWise Team"
EMAIL_SENDER_ADDRESS=your_verified_brevo_sender_here   # must be verified in Brevo

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME="your_smtp_username_here"
SMTP_PASSWORD="your_smtp_password_here"

# Public base URLs used to build links inside emails.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
GEMINI_API_KEY=your_gemini_api_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here
PARSEBOT_API_KEY=your_parsebot_api_key_here
SERP_API_KEY=your_serp_api_key_here